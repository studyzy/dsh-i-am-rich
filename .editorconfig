# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a hard line break, so never trim it there.
[*.md]
trim_trailing_whitespace = false

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[*.{css,scss,less,html}]
indent_style = space
indent_size = 2

[{Makefile,makefile,GNUmakefile}]
indent_style = tab

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

[*.{patch,diff}]
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = false
